{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    ".next-cierre317/types/**/*.ts",
    ".next-cierre317/dev/types/**/*.ts",
    ".next-cierre318/types/**/*.ts",
    ".next-cierre318/dev/types/**/*.ts",
    ".next-cierre319/types/**/*.ts",
    ".next-cierre319/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "examples",
    "backend",
    "venv",
    "docs",
    "bridge",
    "backups",
    "backups/**",
    "**/backups/**"
  ]
}
