POLIS_ENVIRONMENT=development
POLIS_DATABASE_URL=postgresql+asyncpg://polis:polis_local@127.0.0.1:5433/polis
POLIS_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
POLIS_LOG_LEVEL=INFO

# Identidad: definir secretos propios y URL pública HTTPS en producción.
POLIS_JWT_SECRET_KEY=cambiar_por_un_secreto_aleatorio_de_al_menos_32_caracteres
POLIS_IP_SALT=cambiar_por_otro_secreto_aleatorio
POLIS_JWT_EXPIRACION_HORAS=24
POLIS_IDENTIDAD_URL_PUBLICA=http://localhost:3000
# SMTP sin valores: recuperación/verificación responden 503 hasta configurar transporte.
# POLIS_SMTP_HOST=
POLIS_SMTP_PORT=587
POLIS_SMTP_TLS=true
# POLIS_SMTP_USUARIO=
# POLIS_SMTP_CONTRASENA=
POLIS_SMTP_REMITENTE=Polis Plataforma <no-reply@example.org>
POLIS_IDENTIDAD_TOKEN_MINUTOS=30
# Herald Fase 3: resumen diario de pendientes para funcionarios (Encargo 275).
# POLIS_HERALD_RESUMEN_ACTIVO=true
POLIS_IDENTIDAD_LIMITE_IP=60
POLIS_IDENTIDAD_LIMITE_CUENTA=10
POLIS_IDENTIDAD_VENTANA_SEGUNDOS=900
POLIS_GOOGLE_CLIENT_ID=PENDIENTE_CONFIGURAR

# Recepción de WhatsApp: habilitar solo con ambos secretos propios configurados.
POLIS_WHATSAPP_HABILITADO=false
# POLIS_WHATSAPP_APP_SECRET=
# POLIS_WHATSAPP_VERIFY_TOKEN=

# SM Core 310 — apagado hasta migraciones/revisión y coordinación.
POLIS_SM_WORKER_HABILITADO=false
POLIS_SM_EVENTOS_DOMINIO=[]
# Corte real Herald→SM por tipo: exige el mismo tipo en POLIS_SM_EVENTOS_DOMINIO.
# Vacío: Herald envía todo. Reversa: vaciar y ejecutar worker_cli --liberar-delegadas.
POLIS_SM_CORTE_TIPOS=[]
# POLIS_SM_BOVEDA_KEY=<32 bytes aleatorios base64; no reutilizar JWT/MFA>
POLIS_SM_BOVEDA_KEY_ID=v1
# POLIS_SM_BOVEDA_CLAVES_ANTERIORES={"anterior":"base64"}
POLIS_SM_WORKER_BASE_SEGUNDOS=30
POLIS_SM_WORKER_MAX_REINTENTOS=5
POLIS_SM_WORKER_LEASE_SEGUNDOS=120
POLIS_SM_HTTP_TIMEOUT_SEGUNDOS=10
POLIS_SM_WEBHOOK_ORIGENES=[]
# POLIS_SM_WEBHOOK_SECRET=<secreto independiente de al menos 32 caracteres>
# POLIS_SM_TELEGRAM_TOKEN=<Bot API oficial>
# POLIS_SM_WHATSAPP_TOKEN=<token de Meta>
# POLIS_SM_WHATSAPP_PHONE_ID=<id oficial>
# POLIS_SM_WHATSAPP_API_VERSION=<version Graph vigente aprobada>
# POLIS_SM_WHATSAPP_PLANTILLA=<plantilla aprobada con un parámetro de cuerpo>
POLIS_SM_WHATSAPP_PLANTILLA_APROBADA=false
POLIS_SM_WHATSAPP_IDIOMA=es_CO
