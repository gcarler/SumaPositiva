POLIS_ENVIRONMENT=development
POLIS_DATABASE_URL=postgresql+asyncpg://polis:polis_local@127.0.0.1:5433/polis
POLIS_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
POLIS_LOG_LEVEL=INFO

# Identidad: definir secretos propios y URL pública HTTPS en producción.
POLIS_JWT_SECRET_KEY=cambiar_por_un_secreto_aleatorio_de_al_menos_32_caracteres
POLIS_IP_SALT=cambiar_por_otro_secreto_aleatorio
POLIS_JWT_EXPIRACION_HORAS=24
POLIS_IDENTIDAD_URL_PUBLICA=http://localhost:3000
# SMTP sin valores: recuperación/verificación responden 503 hasta configurar transporte.
# POLIS_SMTP_HOST=
POLIS_SMTP_PORT=587
POLIS_SMTP_TLS=true
# POLIS_SMTP_USUARIO=
# POLIS_SMTP_CONTRASENA=
POLIS_SMTP_REMITENTE=POLIS <no-reply@example.org>
POLIS_IDENTIDAD_TOKEN_MINUTOS=30
POLIS_IDENTIDAD_LIMITE_IP=60
POLIS_IDENTIDAD_LIMITE_CUENTA=10
POLIS_IDENTIDAD_VENTANA_SEGUNDOS=900
POLIS_GOOGLE_CLIENT_ID=PENDIENTE_CONFIGURAR

# Recepción de WhatsApp: habilitar solo con ambos secretos propios configurados.
POLIS_WHATSAPP_HABILITADO=false
# POLIS_WHATSAPP_APP_SECRET=
# POLIS_WHATSAPP_VERIFY_TOKEN=
