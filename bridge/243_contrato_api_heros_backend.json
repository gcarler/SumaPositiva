{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contrato API Gestión de Heros y Catálogo — POLIS 2026",
  "version": "1.2.0",
  "date": "2026-10-27T11:49:30Z",
  "endpoints": {
    "obtener_configuracion": {
      "path": "/api/v1/politicas/heros",
      "method": "GET",
      "auth_required": false,
      "description": "Obtiene la configuración activa de diapositivas hero para la portada y el catálogo. Admite slides vacíos (cero fotos / retícula institucional). Incluye heroImageId en la raíz.",
      "response_200": {
        "content_type": "application/json",
        "schema": {
          "$ref": "#/$defs/HerosConfig"
        }
      }
    },
    "actualizar_configuracion": {
      "path": "/api/v1/politicas/heros",
      "method": "PUT",
      "auth_required": true,
      "roles_permitidos": ["autoridad_distrital", "administrador_identidades", "auditor_forense"],
      "headers": {
        "Authorization": "Bearer <TOKEN_JWT>"
      },
      "description": "Actualiza atómicamente la lista de slides y el catálogo de imágenes persistido en el servidor. Admite slides=[] y catalogoImagenes=[] explícitamente vacíos, heroImageId a nivel raíz y reemplazo total de pageImages.",
      "request_body": {
        "content_type": "application/json",
        "schema": {
          "$ref": "#/$defs/HerosConfig"
        }
      },
      "response_200": {
        "description": "Configuración guardada exitosamente y retornada con persistencia garantizada en /root/polis/data/heros_config.json",
        "schema": {
          "$ref": "#/$defs/HerosConfig"
        }
      }
    },
    "subir_imagen": {
      "path": "/api/v1/politicas/heros/subir-imagen",
      "method": "POST",
      "auth_required": true,
      "roles_permitidos": ["autoridad_distrital", "administrador_identidades", "auditor_forense"],
      "description": "Sube un archivo de imagen al servidor (JPG/PNG/WEBP <= 10MB) y lo almacena en public/images/hero",
      "request_body": {
        "content_type": "multipart/form-data",
        "fields": {
          "archivo": "binary file"
        }
      },
      "response_200": {
        "schema": {
          "type": "object",
          "properties": {
            "url": { "type": "string", "example": "/images/hero/hero-custom-1234567890.webp" },
            "nombre": { "type": "string", "example": "hero-custom-1234567890.webp" }
          },
          "required": ["url", "nombre"]
        }
      }
    }
  },
  "$defs": {
    "HeroAccionPrimaria": {
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "href": { "type": ["string", "null"] },
        "onClickAction": { "type": ["string", "null"] }
      },
      "required": ["label"]
    },
    "HeroSlide": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "titulo": { "type": "string" },
        "subtitulo": { "type": "string" },
        "enfoque": { "type": "string", "default": "" },
        "imagenFondo": { "type": "string" },
        "ubicacionReal": { "type": "string", "default": "" },
        "altura": { "type": "string", "default": "fullscreen" },
        "badgeTexto": { "type": "string", "default": "" },
        "activa": { "type": "boolean", "default": true },
        "heroImageId": { "type": ["string", "null"], "default": null },
        "accionPrimaria": {
          "oneOf": [
            { "$ref": "#/$defs/HeroAccionPrimaria" },
            { "type": "null" }
          ]
        }
      },
      "required": ["id", "titulo", "subtitulo", "imagenFondo"]
    },
    "HeroImageOption": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "titulo": { "type": "string" },
        "descripcion": { "type": "string", "default": "" },
        "archivo": { "type": "string" },
        "thumbnail": { "type": "string", "default": "" },
        "enfoque": { "type": "string", "default": "" },
        "habilitada": { "type": "boolean", "default": true },
        "heroImageId": { "type": ["string", "null"], "default": null }
      },
      "required": ["id", "titulo", "archivo"]
    },
    "HerosConfig": {
      "type": "object",
      "properties": {
        "slides": {
          "type": "array",
          "items": { "$ref": "#/$defs/HeroSlide" },
          "default": []
        },
        "catalogoImagenes": {
          "type": "array",
          "items": { "$ref": "#/$defs/HeroImageOption" },
          "default": []
        },
        "opacidad": { "type": "integer", "minimum": 10, "maximum": 95, "default": 80 },
        "modoCarrusel": { "type": "boolean", "default": true },
        "intervaloSegundos": { "type": "integer", "minimum": 1, "maximum": 60, "default": 7 },
        "heroImageId": { "type": ["string", "null"], "default": null },
        "pageImages": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "default": {}
        }
      },
      "required": ["slides", "catalogoImagenes"]
    }
  }
}
