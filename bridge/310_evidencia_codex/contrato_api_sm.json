  "info": {
    "title": "SM Core 310-BK",
    "version": "candidato-congelado"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/sm/consent": {
      "post": {
        "description": "Registra de manera segura el consentimiento previo del titular para un canal.",
        "operationId": "registrar_consentimiento_api_v1_sm_consent_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SMConsentimientoIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SMConsentimiento"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Registrar o actualizar consentimiento",
        "tags": [
          "SM Core"
        ]
      }
    },
    "/api/v1/sm/consent/{canal}/{actor}": {
      "get": {
        "description": "Verifica si un contacto tiene consentimiento vigente (otorgado) sin exponer el contacto crudo.",
        "operationId": "verificar_consentimiento_api_v1_sm_consent__canal___actor__get",
        "parameters": [
          {
            "in": "path",
            "name": "canal",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/SMCanal"
            }
          },
          {
            "in": "path",
            "name": "actor",
            "required": true,
            "schema": {
              "title": "Actor",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "contacto_hash",
            "required": true,
            "schema": {
              "pattern": "^[a-f0-9]{64}$",
              "title": "Contacto Hash",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SMRespuestaVerificacionConsentimiento"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Verificar consentimiento activo",
        "tags": [
          "SM Core"
        ]
      }
    },
    "/api/v1/sm/events": {
      "post": {
        "description": "Ingresa un evento hacia el outbox multicanal con idempotencia y auditoría forense.",
        "operationId": "procesar_evento_api_v1_sm_events_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SMEventoIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SMMensaje"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Ingestar evento transaccional",
        "tags": [
          "SM Core"
        ]
      }
    },
    "/api/v1/sm/health": {
      "get": {
        "description": "Retorna las métricas agregadas del subsistema de mensajería transaccional.",
        "operationId": "salud_sm_api_v1_sm_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SMSalud"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Estado de salud operativo de SM Core",
        "tags": [
          "SM Core"
        ]
      }
    },
    "/api/v1/sm/messages": {
      "get": {
        "description": "Lista mensajes del outbox con filtros operativos.",
        "operationId": "listar_mensajes_api_v1_sm_messages_get",
        "parameters": [
          {
            "in": "query",
            "name": "canal",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/SMCanal"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Canal"
            }
          },
          {
            "in": "query",
            "name": "estado",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/SMEstadoMensaje"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Estado"
            }
          },
          {
            "in": "query",
            "name": "limite",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limite",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SMMensaje"
                  },
                  "title": "Response Listar Mensajes Api V1 Sm Messages Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Listar mensajes del outbox",
        "tags": [
          "SM Core"
        ]
      }
    },
    "/api/v1/sm/messages/{mensaje_id}": {
      "get": {
        "description": "Consulta el estado del outbox sin exponer PII.",
        "operationId": "consultar_mensaje_api_v1_sm_messages__mensaje_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "mensaje_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Mensaje Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SMMensaje"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Consultar mensaje del outbox",
        "tags": [
          "SM Core"
        ]
      }
    },
    "/api/v1/sm/worker/run-once": {
      "post": {
        "description": "Ejecuta una ronda de despacho de mensajes encolados aplicando reintentos y auditoría.",
        "operationId": "ejecutar_worker_api_v1_sm_worker_run_once_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/SMWorkerRunIn"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Payload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SMResumenProcesamiento"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Disparar procesamiento de outbox (worker)",
        "tags": [
          "SM Core"
        ]
      }
    }
  }
