8:["$","section",null,{"aria-labelledby":"seccion-que-es","className":"mb-12 space-y-6","children":[["$","div",null,{"className":"flex items-center gap-3","children":[["$","div",null,{"className":"flex size-10 items-center justify-center rounded-lg bg-[var(--surface-2)] border border-[var(--border-strong)] p-1.5 shadow-xs","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","viewBox":"26 4 172 190","fill":"none","aria-hidden":"true","className":"size-full","style":{},"children":[["$","path",null,{"d":"M44 176 V90","stroke":"var(--brand-polis-blue)","strokeWidth":"18","strokeLinecap":"round"}],["$","path",null,{"d":"M44 90 C44 52.4446 74.4446 22 112 22 C149.555 22 180 52.4446 180 90 C180 127.555 149.555 158 112 158 H78","stroke":"var(--brand-polis-sky)","strokeWidth":"18","strokeLinecap":"round"}],["$","path",null,{"d":"M68 90 C68 65.6995 87.6995 46 112 46 C136.301 46 156 65.6995 156 90 C156 114.301 136.301 134 112 134","stroke":"var(--brand-polis-cyan)","strokeWidth":"14","strokeLinecap":"round"}],["$","circle",null,{"cx":"112","cy":"90","r":"22","fill":"var(--brand-polis-light)"}],["$","circle",null,{"cx":"112","cy":"90","r":"9","fill":"var(--brand-polis-core)"}]]}]}],["$","div",null,{"children":[["$","h2",null,{"id":"seccion-que-es","className":"text-xl sm:text-2xl font-semibold text-[var(--text-primary)]","children":"¿Qué es el Sistema POLIS?"}],["$","p",null,{"className":"text-xs text-[var(--text-tertiary)]","children":"Misión, fundamentos operativos y arquitectura de gobernanza"}]]}]]}],["$","div",null,{"className":"rounded-xl border border-[var(--border)] bg-[var(--surface-1)] p-6 sm:p-8 space-y-4","children":[["$","p",null,{"className":"text-sm sm:text-base leading-relaxed text-[var(--text-secondary)]","children":"POLIS (Plataforma de Operación Local e Inteligencia Social) es una plataforma integral de gobernanza democrática diseñada para canalizar la voz y prioridades de las comunidades hacia la toma de decisiones institucionales vinculantes. Nacida para superar los modelos tradicionales de consulta pasiva, POLIS transforma la participación en un proceso auditable, continuo y estructurado en tiempo real."}],["$","p",null,{"className":"text-sm sm:text-base leading-relaxed text-[var(--text-secondary)]","children":"A través de módulos interconectados, POLIS enlaza el diagnóstico situado en los barrios, la formulación de alternativas de solución, el costeo presupuestal plurianual (FONSET, SGP, SGR) y el seguimiento a metas del Plan de Desarrollo Distrital (PDD), protegiendo la dignidad y no revictimización de los participantes bajo el principio de acción sin daño."}]]}]]}]
