    "MINIMO_EXPONENTE_DECIMAL": -100,
    "MAXIMO_DIGITOS_DIFERENCIA": 256,
    "MAXIMO_EXPONENTE_DIFERENCIA": 100,
    "MINIMO_EXPONENTE_DIFERENCIA": -100,
    "MAXIMO_BYTES_ENTRADA": 2000000
  },
